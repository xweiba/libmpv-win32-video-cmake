+        *is_http = proto_name != NULL && av_strstart(proto_name, "http", NULL);
 
     return ret;
 }
@@ -1234,7 +1245,10 @@ static int parse_manifest(AVFormatContext *s, const char *url, AVIOContext *in)
         close_in = 1;
 
         av_dict_copy(&opts, c->avio_opts, 0);
